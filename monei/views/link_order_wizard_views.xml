<odoo>
    <record id="view_monei_payment_link_order_wizard_form" model="ir.ui.view">
        <field name="name">monei.payment.link.order.wizard.form</field>
        <field name="model">monei.payment.link.order.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="sale_order_id"/>
                </group>
                <footer>
                    <button string="Link" type="object" name="action_link" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo> 